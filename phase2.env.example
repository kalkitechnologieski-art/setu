# Bulk import template for: ./phase2.sh import phase2.env
# Fill in values, save as phase2.env, then run the import.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key (server-only)
SUPABASE_SERVICE_ROLE_KEY=
# Groq API key (primary LLM)
GROQ_API_KEY=
# Google Gemini API key (fallback 1)
GEMINI_API_KEY=
# OpenRouter API key (fallback 2)
OPENROUTER_API_KEY=
# Resend email API key
RESEND_API_KEY=
# AgentCall telephony API key
AGENTCALL_API_KEY=
# Assigned AgentCall US/CA number
AGENTCALL_FROM_NUMBER=
# Munin Cloud MCP server URL
MUNIN_MCP_URL=
# Munin API key (if required by instance)
MUNIN_API_KEY=
# Markifact MCP endpoint
MARKIFACT_MCP_URL=
# Markifact bearer token (OAuth-derived)
MARKIFACT_API_KEY=
# LangSmith API key
LANGSMITH_API_KEY=
# LangSmith project name
LANGSMITH_PROJECT=
# Enable LangSmith tracing
LANGSMITH_TRACING=
# Cloudflare account ID
CF_ACCOUNT_ID=
# Cloudflare KV namespace ID
CF_KV_NAMESPACE=
# Cloudflare API token
CF_API_TOKEN=
# Pinecone API key (vector store)
PINECONE_API_KEY=
# Pinecone index name
PINECONE_INDEX=
# App base URL
NEXT_PUBLIC_APP_URL=
